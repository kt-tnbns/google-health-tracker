# --- App ---
PORT=3000
# Public base URL of this service (used to build the OAuth redirect URI).
# Example on Dokploy: https://health.example.com
PUBLIC_BASE_URL=http://localhost:3000
# Shared secret for the private HTTP API. Send as header: x-admin-token: <value>
ADMIN_TOKEN=change-me-long-random
# IANA timezone used for "which day does this measurement belong to"
USER_TIMEZONE=Asia/Bangkok

# --- Database ---
DATABASE_URL=postgres://health:health@localhost:5432/health

# --- Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Default: ${PUBLIC_BASE_URL}/auth/google/callback
# GOOGLE_REDIRECT_URI=
# 32-byte key, base64 encoded, used to encrypt refresh tokens at rest:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- GLM (not used yet; reserved for the coaching phase) ---
# GLM_API_KEY=
# GLM_BASE_URL=
# GLM_MODEL=

# --- Telegram (not used yet) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
