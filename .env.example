# --- App ---
PORT=3000
# Public base URL of this service (used to build the OAuth redirect URI).
# Example on Dokploy: https://health.example.com
PUBLIC_BASE_URL=http://localhost:3000
# Shared secret for the private HTTP API. Send as header: x-admin-token: <value>
ADMIN_TOKEN=change-me-long-random
# IANA timezone used for "which day does this measurement belong to"
USER_TIMEZONE=Asia/Bangkok
# Background sync is enabled by default. Set false for manual-only operation.
AUTO_SYNC_ENABLED=true
# Raw Google response retention; must be at least 30 days. Daily metrics remain long-lived.
RAW_RETENTION_DAYS=30

# --- Database ---
DATABASE_URL=postgres://health:health@localhost:5432/health

# --- Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Default: ${PUBLIC_BASE_URL}/auth/google/callback
# GOOGLE_REDIRECT_URI=
# 32-byte key, base64 encoded, used to encrypt refresh tokens at rest:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- GLM / Z.ai (AI coach) — OpenAI-compatible endpoint ---
GLM_API_KEY=
# Coding Plan keys use https://api.z.ai/api/coding/paas/v4 instead
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.3
# GLM_THINKING=disabled   # 'enabled' to let the model reason before answering (slower, more tokens)

# --- Telegram (not used yet) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
